# dependencies
node_modules/
__pycache__/

# build output
# dist/ is committed: the plugin runs the bundle with no install step
*.tsbuildinfo

# environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# test and coverage
coverage/
.vitest/

# editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# release-workflow lock
.claude/release-workflow-active.lock

# Git Bash crash dumps
*.stackdump
